{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "convert",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "convert.shiftbloom.studio", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.txt"], "fallthrough": true }],
  "triggers": { "crons": ["17 * * * *"] },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "convert-files" }],
  "d1_databases": [{ "binding": "DB", "database_name": "convert-db", "database_id": "bf1c5829-9e1b-45de-8e27-071e74cd6b3e" }],
  "images": { "binding": "IMAGES" },
  "media": { "binding": "MEDIA" },
  "stream": { "binding": "STREAM" },
  "workflows": [{ "binding": "CONVERT_JOB", "name": "convert-job", "class_name": "ConvertJob" }],
  "ratelimits": [
    { "name": "IMG_LIMIT", "namespace_id": "4101", "simple": { "limit": 30, "period": 60 } },
    { "name": "JOB_LIMIT", "namespace_id": "4102", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAAGSsyC-e0UCdfowd",
    "IMAGE_DAILY_PER_IP": "300",
    "IMAGE_DAILY_GLOBAL": "2000",
    "JOB_DAILY_PER_IP": "15",
    "JOB_DAILY_GLOBAL": "200"
  }
  // Secret: TURNSTILE_SECRET (wrangler secret put TURNSTILE_SECRET)
}
